{
  "description": "The guards of the OpenCAD plugin. They act only when the environment variable OPENCAD_HOOKS is 1.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/opencad-hook\" guard-requirements", "timeout": 60 }]
      },
      {
        "matcher": "mcp__(plugin_opencad_)?opencad__(quote_request|order_prepare|mfg_dispatch)",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/opencad-hook\" guard-external", "timeout": 60 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/opencad-hook\" build-reminder", "timeout": 60 }]
      }
    ]
  }
}
